{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "module": {
      "$ref": "#/$defs/module"
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/topic"
      }
    }
  },
  "required": [
    "schemaVersion",
    "topics"
  ],
  "additionalProperties": false,
  "$defs": {
    "module": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "title",
        "revision"
      ],
      "additionalProperties": false
    },
    "topic": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/theory"
              },
              {
                "$ref": "#/$defs/code"
              }
            ]
          }
        }
      },
      "required": [
        "id",
        "title",
        "revision",
        "items"
      ],
      "additionalProperties": false
    },
    "theory": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "theory"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "title",
        "type",
        "text"
      ],
      "additionalProperties": false
    },
    "code": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "code"
        },
        "assignment": {
          "type": "string",
          "minLength": 1
        },
        "expectedOutput": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "title",
        "type",
        "assignment",
        "expectedOutput"
      ],
      "additionalProperties": false
    }
  }
}
